# Universal News Scraper - Environment Configuration Template
# Copy to .env and fill in your values

# Proxy Configuration
PROXY_FILE=proxies.json
ENABLE_PROXIES=true

# Scraping Configuration
MAX_CONCURRENT_TASKS=5
REQUEST_TIMEOUT=15
MIN_REQUEST_INTERVAL=1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=scraper.log

# Output
OUTPUT_FORMAT=json
OUTPUT_FILE=data/articles.json
URL_QUEUE_FILE=data/url_queue.json

# Features
USE_CURL_CFFI=true
ENABLE_TLS_MIMICRY=true
ENABLE_STICKY_SESSIONS=true

# Bot Detection Evasion
ROTATE_USER_AGENTS=true
ROTATE_PROXIES=true
RANDOM_DELAYS=true
